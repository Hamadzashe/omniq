# Local / Cloudflare secrets (never commit real values, never put in frontend JS)
OQUMAIL_API_KEY=oqm_live_your_key_here
CONTACT_TO=you@yourdomain.com
MAIL_FROM_NAME=OMNIQ Integrated Systems

# Optional: only if OquMail requires an explicit From address for your key
# MAIL_FROM=noreply@yourdomain.com

# Local Express server only
PORT=3000
CORS_ORIGIN=*

# Cloudflare Pages:
# Project Settings → Environment variables (Production)
# Add: OQUMAIL_API_KEY, CONTACT_TO, MAIL_FROM_NAME
# (and MAIL_FROM if needed)
